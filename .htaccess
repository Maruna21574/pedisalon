# --- PediSalón ZK: Apache nastavenia (WebSupport) ---
Options -Indexes
ErrorDocument 404 /404.php
DirectoryIndex index.php

# Kompresia
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache statických súborov
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Zákaz priameho prístupu k dátam a konfigurácii
<FilesMatch "^(config\.php|\.htaccess)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(data|inc)/ - [F,L]
  # Presmerovanie /index.php na /
  RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
  RewriteRule ^index\.php$ / [R=301,L]
  # Pekné URL: /galeria.php -> /galeria (iba hlavné stránky, nie admin/ a api/)
  RewriteCond %{THE_REQUEST} \s/([a-z0-9-]+)\.php[\s?] [NC]
  RewriteRule ^([a-z0-9-]+)\.php$ /$1 [R=301,L]
  # /galeria sa interne spracuje ako galeria.php
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([a-z0-9-]+)$ $1.php [L]
</IfModule>

# Bezpečnostné hlavičky
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
